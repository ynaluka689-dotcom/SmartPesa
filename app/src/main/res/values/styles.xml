<resources>
    <color name="canvas">#09090B</color>
    <style name="Theme.SmartPesa" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/canvas</item>
    </style>
    <style name="Theme.SmartPesa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartPesa</item>
    </style>
</resources>
